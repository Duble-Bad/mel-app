# Copie para .env.local (na RAIZ do repositório) e preencha.
# Nunca commite .env.local. Chaves do Supabase: rode `npm run env:pull`.

# --- Supabase (projeto de desenvolvimento) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (sb_publishable_...). Segura no navegador: o acesso é limitado por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). IGNORA RLS. Só servidor/testes. NUNCA no navegador.
SUPABASE_SECRET_KEY=

# --- Login com Google ---
# "on" só depois de configurar o provider Google no Supabase (ver README).
NEXT_PUBLIC_AUTH_GOOGLE=off

# --- Mapas (MapTiler) ---
# Pública; restrinja as origens permitidas no painel do MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Antispam (Cloudflare Turnstile) ---
# Valores abaixo = CHAVES DE TESTE oficiais da Cloudflare (sempre aprovam).
# Em produção, crie as reais em dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Futuros milestones ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000      (M5: links e Open Graph)

# --- Web Push (M12) ---
# Gere um par com: npx web-push generate-vapid-keys  (a privada NUNCA no código/Git)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rede.mel.pets@outlook.com
# Agendador (push que ficou para trás + faxina de fotos órfãs): GET ou POST /api/push/dispatch
# com "Authorization: Bearer <segredo>" — nunca na URL. Mínimo 32 caracteres (openssl rand -hex 32).
# CRON_SECRET: o Vercel Cron manda sozinho no GET. PUSH_DISPATCH_SECRET: outro agendador. Basta um.
PUSH_DISPATCH_SECRET=
CRON_SECRET=

# --- Parceiros: dados pessoais (CPF de protetor independente) ---
# SÓ servidor (nunca NEXT_PUBLIC_*). Cada chave: 32 bytes aleatórios em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Chaves diferentes por ambiente; nunca no banco, no navegador ou no Git.
# Sem elas, o cadastro de protetor responde "indisponível" e nada é gravado.
MEL_PII_ENC_KEY=
# Versão da chave atual (rotação: nova chave + nova versão; a antiga vai para PREVIOUS).
MEL_PII_ENC_KEY_VERSION=1
# Chaves antigas, só para abrir valores já gravados: "1:<base64>,2:<base64>"
MEL_PII_ENC_KEYS_PREVIOUS=
# Chave SEPARADA do HMAC-SHA256 que detecta CPF duplicado (diferente da de cifragem).
MEL_PII_HMAC_KEY=
MEL_PII_HMAC_KEY_VERSION=1
# Chaves antigas do HMAC durante a rotação (duplicidade checada em todas): "1:<base64>"
MEL_PII_HMAC_KEYS_PREVIOUS=
# Geração, guarda (gerenciador de senhas + cópia offline, NUNCA junto do backup
# do banco), rotação (npm run pii:rotate) e perda de chave: docs/18-chaves-pii.md

# --- Parceiros: flags do piloto ---
# Consulta automática de CNPJ: "off" (não há fonte oficial gratuita autorizada).
MEL_CNPJ_LOOKUP=off
# Ofertas "Patrocinado": "off" no piloto (sem patrocínio). "on" volta selo e ordem.
MEL_SPONSORED_OFFERS=off
