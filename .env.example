# Copie para .env.local (na RAIZ do repositório) e preencha.
# Nunca commite .env.local. Chaves do Supabase: rode `npm run env:pull`.

# --- Supabase (projeto de desenvolvimento) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (sb_publishable_...). Segura no navegador: o acesso é limitado por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). IGNORA RLS. Só servidor/testes. NUNCA no navegador.
SUPABASE_SECRET_KEY=

# --- Login com Google ---
# "on" só depois de configurar o provider Google no Supabase (ver README).
NEXT_PUBLIC_AUTH_GOOGLE=off

# --- Mapas (MapTiler) ---
# Pública; restrinja as origens permitidas no painel do MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Antispam (Cloudflare Turnstile) ---
# Valores abaixo = CHAVES DE TESTE oficiais da Cloudflare (sempre aprovam).
# Em produção, crie as reais em dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Futuros milestones ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000      (M5: links e Open Graph)

# --- Web Push (M12) ---
# Gere um par com: npx web-push generate-vapid-keys  (a privada NUNCA no código/Git)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rede.mel.pets@outlook.com
# Opcional: agendador chamando POST /api/push/dispatch com "Authorization: Bearer <segredo>"
PUSH_DISPATCH_SECRET=
